-- Safe GUI Parent Guard
local function GetSafeParent()
    local parent = nil
    pcall(function()
        if gethui then parent = gethui()
        else parent = CoreGui end
    end)
    if not parent then parent = LocalPlayer:WaitForChild("PlayerGui") end
    return parent
end

