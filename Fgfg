            if humanoid and backpack then
                local savedTool = backpack:WaitForChild(Config.SavedLiftTool, 3) or backpack:FindFirstChild(Config.SavedLiftTool)
                if savedTool then humanoid:EquipTool(savedTool) end
            end
        end)
    end
end)

-- Direct Backpack Pet Sell Function
local function SellPetsFromBackpack()
    pcall(function()
        local petsFolder = LocalPlayer:FindFirstChild("petsFolder") or LocalPlayer:FindFirstChild("Pets")
        if petsFolder then
            for _, petFolder in ipairs(petsFolder:GetChildren()) do
                local rarity = petFolder:FindFirstChild("Rarity") or petFolder:FindFirstChild("rarity")
                if rarity and string.lower(rarity.Value) == string.lower(Config.SelectedRarityToSell) then
                    if rEvents and rEvents:FindFirstChild("sellPetRemote") then
                        rEvents.sellPetRemote:InvokeServer(petFolder)
                    elseif rEvents and rEvents:FindFirstChild("sellPet") then
                        rEvents.sellPet:FireServer(petFolder)
                    end
                end
            end
        else
            if rEvents and rEvents:FindFirstChild("sellPetRemote") then
                rEvents.sellPetRemote:InvokeServer("sellPetByRarity", Config.SelectedRarityToSell)
            end
        end
    end)
end

