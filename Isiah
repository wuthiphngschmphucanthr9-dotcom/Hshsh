            end
        end)
    end

    -- 2. สวมใส่อุปกรณ์เดิมให้อัตโนมัติ
    if Config.AutoReEquipOnDeath and Config.SavedLiftTool then
        task.spawn(function()
            local humanoid = char:WaitForChild("Humanoid", 5)
            local backpack = LocalPlayer:WaitForChild("Backpack", 5)
            
            if humanoid and backpack then
                local savedTool = backpack:WaitForChild(Config.SavedLiftTool, 3) or backpack:FindFirstChild(Config.SavedLiftTool)
                if savedTool then
                    humanoid:EquipTool(savedTool)
                end
            end
        end)
    end
end)

