-- Safe GUI Parent Guard
local function GetSafeParent()
    local parent = nil
    pcall(function()
        if gethui then
            parent = gethui()
        elseif syn and syn.protect_gui then
            parent = CoreGui
        else
            parent = CoreGui
        end
    end)
    if not parent or not pcall(function() return parent.Name end) then
        parent = LocalPlayer:WaitForChild("PlayerGui")
    end
    return parent
end

