--[[
    Title: Optimized Auto Block Script for TSB
    Description: Clean UI with reliable combat distance tracking for auto-blocking.
--]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local CoreGui = game:GetService("CoreGui")
local VirtualInputManager = game:GetService("VirtualInputManager")

local player = Players.LocalPlayer

-- Clean up existing GUI
if CoreGui:FindFirstChild("TSBAutoBlockGUI") then
    CoreGui.TSBAutoBlockGUI:Destroy()
end

-- Create ScreenGui
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "TSBAutoBlockGUI"
screenGui.ResetOnSpawn = false
screenGui.Parent = CoreGui

-- Create Main Frame
local mainFrame = Instance.new("Frame")
mainFrame.Name = "MainFrame"
mainFrame.Size = UDim2.new(0, 240, 0, 120)
mainFrame.Position = UDim2.new(0.05, 0, 0.25, 0)
mainFrame.BackgroundColor3 = Color3.fromRGB(24, 24, 24)
mainFrame.BorderSizePixel = 0
mainFrame.Active = true
mainFrame.Draggable = true
mainFrame.Parent = screenGui

local uiCorner = Instance.new("UICorner")
uiCorner.CornerRadius = UDim.new(0, 12)
uiCorner.Parent = mainFrame

-- Title
local titleLabel = Instance.new("TextLabel")
titleLabel.Size = UDim2.new(1, 0, 0, 40)
titleLabel.BackgroundTransparency = 1
titleLabel.Font = Enum.Font.GothamBold
titleLabel.Text = "TSB Auto Block"
titleLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
titleLabel.TextSize = 15
titleLabel.Parent = mainFrame

-- Toggle Button
local toggleButton = Instance.new("TextButton")
toggleButton.Size = UDim2.new(0.85, 0, 0, 48)
toggleButton.Position = UDim2.new(0.075, 0, 0.42, 0)
toggleButton.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
toggleButton.Font = Enum.Font.GothamSemibold
toggleButton.Text = "Status: OFF"
toggleButton.TextColor3 = Color3.fromRGB(255, 90, 90)
toggleButton.TextSize = 14
toggleButton.Parent = mainFrame

local btnCorner = Instance.new("UICorner")
btnCorner.CornerRadius = UDim.new(0, 8)
btnCorner.Parent = toggleButton

-- Logic State
local autoBlockActive = false
local lastBlockTime = 0

toggleButton.MouseButton1Click:Connect(function()
    autoBlockActive = not autoBlockActive
    if autoBlockActive then
        toggleButton.Text = "Status: ON"
        toggleButton.TextColor3 = Color3.fromRGB(90, 255, 90)
        toggleButton.BackgroundColor3 = Color3.fromRGB(35, 75, 35)
    else
        toggleButton.Text = "Status: OFF"
        toggleButton.TextColor3 = Color3.fromRGB(255, 90, 90)
        toggleButton.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
    end
end)

-- Optimized loop for monitoring enemy proximity
RunService.RenderStepped:Connect(function()
    if not autoBlockActive then return end
    
    local character = player.Character
    if not character then return end
    
    local hrp = character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    
    local currentTime = tick()
    -- Prevent spamming inputs too fast
    if currentTime - lastBlockTime < 0.3 then return end

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player and p.Character then
            local enemyHrp = p.Character:FindFirstChild("HumanoidRootPart")
            local enemyHumanoid = p.Character:FindFirstChildOfClass("Humanoid")
            
            if enemyHrp and enemyHumanoid and enemyHumanoid.Health > 0 then
                local distance = (hrp.Position - enemyHrp.Position).Magnitude
                
                -- Detect if enemy is within attack/punch range
                if distance < 7.5 then
                    lastBlockTime = currentTime
                    VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.F, false, game)
                    task.delay(0.15, function()
                        pcall(function()
                            VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.F, false, game)
                        end)
                    end)
                    break
                end
            end
        end
    end
end)
