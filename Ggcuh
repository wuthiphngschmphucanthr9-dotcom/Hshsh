    local function GetTargetRock(requiredReq)
        local rocksFolder = Workspace:FindFirstChild("rocks") or Workspace:FindFirstChild("Rocks") or Workspace
        for _, rock in ipairs(rocksFolder:GetChildren()) do
            if rock:IsA("Model") or rock:IsA("BasePart") then
                local req = rock:FindFirstChild("requiredStrength") or rock:FindFirstChild("Requirement") or rock:FindFirstChild("Need")
