-- TAB 1: AUTO FARM SPEED-RUN
-- -------------------------------------------------------------
AddToggle(FarmTab, "ระบบวิ่งฟาร์มอัตโนมัติ (Speed-Run Auto Farm)", function(state)
	Config.AutoFarm = state
	Config.Noclip = state
	if state then Notify("Sunday Hub", "เปิดระบบวิ่งทะลุด่านฟาร์มออโต้!", 2) end

	task.spawn(function()
		while Config.AutoFarm do
			task.wait(0.1)
			local char = LocalPlayer.Character
			if not char or not char:FindFirstChild("HumanoidRootPart") then continue end

			local eggFolder = workspace:FindFirstChild("SpawnedEggs") or workspace
			local targetPrompt = nil
			local bestPriority = -1

			-- คัดเลือกลำดับความหายาก
			for _, prompt in pairs(eggFolder:GetDescendants()) do
				if prompt:IsA("ProximityPrompt") and prompt.Enabled then
					local eggPart = prompt.Parent
					local eggType = eggPart:GetAttribute("Type") or eggPart.Name
					local priority = 1

					if string.find(eggType, "Legendary") then priority = 4
					elseif string.find(eggType, "Epic") then priority = 3
					elseif string.find(eggType, "Rare") then priority = 2 end

					if priority > bestPriority then
						bestPriority = priority
						targetPrompt = prompt
					end
				end
			end

			-- วิ่งทะลุด่านไปหาไข่ แล้ววิ่งกลับฐาน
			if targetPrompt and targetPrompt.Parent then
				-- วิ่งพุ่งไปหาไข่
				runToTarget(targetPrompt.Parent.CFrame + Vector3.new(0, 2, 0))
				task.wait(0.1)
				fireproximityprompt(targetPrompt)
				task.wait(0.1)
				
				-- วิ่งพุ่งกลับฐานนำส่ง
				local myBase = getMyBase()
				if myBase then
