-- 5. SPEED-RUN PATHFINDING & NOCLIP LOGIC (ระบบวิ่งทะลุด่านด้วยความเร็ว)
--------------------------------------------------------------------------------

local function getMyBase()
	local bases = workspace:FindFirstChild("Bases")
	if bases then
		for _, base in pairs(bases:GetChildren()) do
			if base:GetAttribute("Owner") == LocalPlayer.Name then
				return base:FindFirstChild("NestZone") or base
			end
		end
	end
	return nil
end

-- ระบบ Noclip ทะลุกำแพงและสิ่งกีดขวาง
RunService.Stepped:Connect(function()
	if Config.Noclip or Config.AutoFarm then
		if LocalPlayer.Character then
			for _, part in pairs(LocalPlayer.Character:GetDescendants()) do
				if part:IsA("BasePart") and part.CanCollide then
					part.CanCollide = false
				end
			end
		end
	end
end)

-- ระบบพุ่งตัวไปหาเป้าหมายด้วยความเร็วสูงทะลุด่าน (แทนการวาร์ป)
local function runToTarget(targetCFrame)
	local char = LocalPlayer.Character
	if not char or not char:FindFirstChild("HumanoidRootPart") then return end
	local hrp = char.HumanoidRootPart

	local distance = (hrp.Position - targetCFrame.Position).Magnitude
	local travelTime = math.clamp(distance / Config.FarmSpeed, 0.05, 3)

	local tweenInfo = TweenInfo.new(travelTime, Enum.EasingStyle.Linear)
	local tween = TweenService:Create(hrp, tweenInfo, {CFrame = targetCFrame})
	
	tween:Play()
	tween.Completed:Wait()
end

