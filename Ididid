local activeEggHighlights = {}
AddToggle(VisualTab, "มองเห็นตำแหน่งไข่ (Egg ESP)", function(state)
	Config.EggESP = state
	if not state then
		for _, hl in pairs(activeEggHighlights) do if hl then hl:Destroy() end end
		activeEggHighlights = {}
		return
	end

	Notify("Sunday Hub", "เปิดใช้งาน Egg ESP นีออน", 2)
	task.spawn(function()
		while Config.EggESP do
			local eggFolder = workspace:FindFirstChild("SpawnedEggs") or workspace
			for _, egg in pairs(eggFolder:GetChildren()) do
				if egg:IsA("BasePart") and not egg:FindFirstChild("SundayESP") then
					local hl = Instance.new("Highlight")
					hl.Name = "SundayESP"
					
					local typeName = egg:GetAttribute("Type") or egg.Name
					if string.find(typeName, "Legendary") then hl.FillColor = RarityColors.Legendary
					elseif string.find(typeName, "Epic") then hl.FillColor = RarityColors.Epic
					elseif string.find(typeName, "Rare") then hl.FillColor = RarityColors.Rare
					else hl.FillColor = RarityColors.Common end

					hl.OutlineColor = Color3.fromRGB(255, 255, 255)
					hl.FillTransparency = 0.3
					hl.Parent = egg
					table.insert(activeEggHighlights, hl)
				end
			end
			task.wait(1.5)
		end
	end)
end)

