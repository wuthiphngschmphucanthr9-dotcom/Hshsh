-- Minimize State Logic
local isMinimized = false
toggleBtn.MouseButton1Click:Connect(function()
	isMinimized = not isMinimized
	local targetSize = isMinimized and UDim2.new(0, 220, 0, 35) or UDim2.new(0, 220, 0, 110)
	contentFrame.Visible = not isMinimized
	toggleBtn.Text = isMinimized and "+" or "-"
	
	local tween = TweenService:Create(mainFrame, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Size = targetSize})
	tween:Play()
end)

-- Draggable UI Logic for Mobile & PC
local dragging, dragInput, dragStart, startPos
mainFrame.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging = true
		dragStart = input.Position
		startPos = mainFrame.Position
		
		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				dragging = false
			end
		end)
	end
end)

mainFrame.InputChanged:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
		dragInput = input
	end
end)

game:GetService("UserInputService").InputChanged:Connect(function(input)
	if input == dragInput and dragging then
		local delta = input.Position - dragStart
		mainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
	end
end)

-- Copy to Clipboard Functionality
copyBtn.MouseButton1Click:Connect(function()
	local currentText = copyBtn.Text
	-- Get asset id or song name text
	local songText = songNameLabel.Text
	if songText ~= "ไม่มีเพลงที่กำลังเล่น" then
		if setclipboard then
			setclipboard(songText)
			copyBtn.Text = "คัดลอกแล้ว!"
			task.wait(1.5)
			copyBtn.Text = currentText
		else
			copyBtn.Text = "ไม่รองรับคลิปบอร์ด"
			task.wait(1.5)
			copyBtn.Text = currentText
		end
	end
end)

-- Remote Event Listener for Global Map Music Updates
-- Expecting ReplicatedStorage.UpdateMusicState (RemoteEvent)
local remoteEvent = ReplicatedStorage:FindFirstChild("UpdateMusicState")
if remoteEvent then
	remoteEvent.OnClientEvent:Connect(fnction(songTitle, isPlaying)
		if isPlaying and songTitle then
			songNameLabel.Text = songTitle
		else
			songNameLabel.Text = "ไม่มีเพลงที่กำลังเล่น"
		end
	end)
end
